# OpenAI-compatible Provider Configuration (Server-Side Only)
# API keys are securely kept on the server and never exposed to the client.

# Default OpenAI API Key
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Optional: Custom OpenAI-compatible Base URL
# Examples:
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Default Model Name
OPENAI_MODEL=gpt-4o-mini
